# Application Configuration
APP_NAME=PayPilot AI
APP_DESCRIPTION=AI-powered business and payment intelligence platform.
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL Database (Docker Compose maps host port 5433 to container port 5432)
POSTGRES_USER=paypilot_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=paypilot_ai
DATABASE_URL=postgresql+psycopg://paypilot_user@localhost:5433/paypilot_ai

# PayPal Integration (Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI Intelligence Service
AI_API_KEY=
