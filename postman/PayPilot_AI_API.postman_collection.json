              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"What is our settled revenue and pending receivables status?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/copilot/chat",
              "host": ["{{baseUrl}}"],
              "path": ["copilot", "chat"]
            },
            "description": "Interacts with PayPilot AI assistant grounded in deterministic commerce data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns valid reply and context\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.reply).to.be.a('string');",
                  "    pm.expect(data.context_summary).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Payment Approval Workflows",
      "item": [
        {
          "name": "Approve Customer Payment (Owner Approval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_ref\": \"{{transactionRef}}\",\n  \"owner_approved\": true,\n  \"idempotency_key\": \"postman-exec-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/approve",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "approve"]
            },
            "description": "Executes owner-approved payment capture with idempotency guarantees."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 400 (if already captured/invalid)\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Collection-level pre-request setup",
          "if (!pm.environment.get(\"userId\")) {",
          "    pm.environment.set(\"userId\", \"owner_default\");",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ]
