  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Root Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rootUrl}}/",
              "host": ["{{rootUrl}}"],
              "path": [""]
            },
            "description": "Returns backend service name and running status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Backend is running\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"running\");",
                  "});"
