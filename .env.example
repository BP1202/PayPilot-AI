# Application Configuration
APP_NAME=PayPilot AI
APP_DESCRIPTION=AI-powered business and payment intelligence platform.
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL Database (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${DATABASE_NAME}

# PayPal Integration
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI Intelligence Service
AI_API_KEY=

