# Application Configuration
APP_NAME=Opnly
APP_DESCRIPTION=Where Ideas Find the Right People
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (Docker Compose maps host port 5433 to container port 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=paypilot_ai
DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/paypilot_ai

# PayPal Integration (Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI Intelligence Service
AI_API_KEY=
